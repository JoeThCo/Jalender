<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jalender.MainPage"
             xmlns:controls="clr-namespace:Jalender.Controls"
             xmlns:models="clr-namespace:Jalender.Models">

    <ScrollView>
        <Grid ColumnDefinitions="*,*">
            <controls:EventListView Grid.Column="0"
                                    Events="{Binding Events}"
                                    EventDeleted="EventList_EventDeleted"/>
            <controls:NewEventView x:Name="NewEventForm"
                                   EventSaved="NewEventForm_EventSaved"
                                   Cancelled="NewEventForm_Cancelled"
                                   Grid.Column="1"/>
        </Grid>
    </ScrollView>

</ContentPage>
